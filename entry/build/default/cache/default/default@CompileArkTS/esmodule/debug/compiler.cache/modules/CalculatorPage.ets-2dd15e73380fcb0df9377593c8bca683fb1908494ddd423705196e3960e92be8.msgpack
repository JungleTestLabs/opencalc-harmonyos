            Row.height(24);
            // æ‹–æ‹½æ‰‹æŸ„ / æŠ˜å æŒ‰é’®ï¼ˆå§‹ç»ˆå¯è§ï¼Œä»¿ Android sliding_layout_buttonï¼‰
            Row.justifyContent(FlexAlign.Center);
            // æ‹–æ‹½æ‰‹æŸ„ / æŠ˜å æŒ‰é’®ï¼ˆå§‹ç»ˆå¯è§ï¼Œä»¿ Android sliding_layout_buttonï¼‰
            Row.onClick(() => { this.showHistory = false; });
        }, Row);
        this.observeComponentCreation2((elmtId, isInitialRender) => {
            // æ‰‹æŸ„æ¨ªæ¡
            Text.create('');
            // æ‰‹æŸ„æ¨ªæ¡
