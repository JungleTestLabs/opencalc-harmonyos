    // ==================== å†å²é¢æ¿ï¼ˆä»¿ Android SlidingUpPanelLayoutï¼‰ ====================
    HistoryPanel(parent = null) {
        this.observeComponentCreation2((elmtId, isInitialRender) => {
            Column.create();
            Column.layoutWeight(this.isLandscape ? 1 : 0);
