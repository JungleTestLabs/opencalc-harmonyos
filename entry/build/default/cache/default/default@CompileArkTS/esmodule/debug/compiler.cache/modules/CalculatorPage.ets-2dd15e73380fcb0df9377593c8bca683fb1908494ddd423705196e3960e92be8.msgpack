@Entry
@Component
export struct CalculatorPage {
  // ==================== æ˜¾ç¤ºçŠ¶æ€ ====================
  @State expression: string = ''      // å½“å‰è¾“å…¥è¡¨è¾¾å¼
  @State result: string = ''          // è®¡ç®—ç»“æœ
  @State errorMsg: string = ''        // é”™è¯¯ä¿¡æ¯
  @State scientific: boolean = false  // ç§‘å­¦æ¨¡å¼å¼€å…³
  @State history: HistoryItem[] = []  // å†å²è®°å½•åˆ—è¡¨
  @State showHistory: boolean = false // å†å²é¢æ¿å¯è§æ€§
  @State showSettings: boolean = false // è®¾ç½®é¢æ¿å¯è§æ€§
  @State showAbout: boolean = false   // å…³äºé¢æ¿å¯è§æ€§
  @State isLandscape: boolean = false // æ¨ªå±æ¨¡å¼ï¼ˆè‡ªåŠ¨æ£€æµ‹ï¼‰

  // ==================== åå¥½è®¾ç½®çŠ¶æ€ ====================
  @State vibrateOn: boolean = true     // æŒ¯åŠ¨åé¦ˆ
  @State preventSleep: boolean = false // é˜²ä¼‘çœ 
  @State radianMode: boolean = false   // å¼§åº¦æ¨¡å¼ï¼ˆå¦åˆ™ä¸ºè§’åº¦ï¼‰
  @State themeIdx: number = 0          // ä¸»é¢˜ç´¢å¼•

  // ==================== å†…éƒ¨çŠ¶æ€ ====================
  private nextId: number = 0                          // å†å²è®°å½•è‡ªå¢ ID
  private engine: CalcEngine = new CalcEngine()       // è®¡ç®—å¼•æ“å®ä¾‹
  private expr: Expression = new Expression()         // è¡¨è¾¾å¼é¢„å¤„ç†å™¨å®ä¾‹
  private prefs: PreferencesStore | null = null        // åå¥½å­˜å‚¨å®ä¾‹

  /**
   * é¡µé¢åˆå§‹åŒ–ç”Ÿå‘½å‘¨æœŸ
   * åˆ›å»º PreferencesStore å¹¶å¼‚æ­¥åŠ è½½åå¥½å’Œå†å²
   */
  aboutToAppear(): void {
    const ctx: common.UIAbilityContext = getContext(this) as common.UIAbilityContext
    this.prefs = new PreferencesStore(ctx)
    this.prefs.init().then((): void => {
      this.loadPrefs()
      this.loadHistory()
    })
  }

  /** ä»æŒä¹…åŒ–å­˜å‚¨åŠ è½½åå¥½è®¾ç½® */
  async loadPrefs(): Promise<void> {
    if (!this.prefs) return
    this.vibrateOn = await this.prefs.getVibrationEnabled()
    this.preventSleep = await this.prefs.getPreventSleep()
    this.radianMode = await this.prefs.getRadiansDefault()
    this.themeIdx = await this.prefs.getTheme()
    this.scientific = (await this.prefs.getScientificModeDefault()) === 1
  }

  /** ä»æŒä¹…åŒ–å­˜å‚¨åŠ è½½å†å²è®°å½• */
  async loadHistory(): Promise<void> {
    if (!this.prefs) return
    this.history = await this.prefs.getHistory()
    if (this.history.length > 0) this.nextId = this.history[0].id + 1
  }

  /**
   * ä¿å­˜å•ä¸ªåå¥½è®¾ç½®é¡¹
   * @param key åå¥½é”®å
   * @param value åå¥½å€¼
   */
  async savePref(key: string, value: boolean | number): Promise<void> {
    if (!this.prefs) return
    if (key === 'vibrateOn') await this.prefs.setVibrationEnabled(value as boolean)
    else if (key === 'preventSleep') await this.prefs.setPreventSleep(value as boolean)
    else if (key === 'radianMode') await this.prefs.setRadiansDefault(value as boolean)
    else if (key === 'themeIdx') await this.prefs.setTheme(value as number)
    else if (key === 'scientific') await this.prefs.setScientificModeDefault(value as number)
  }

  // ==================== æŒ‰é’®äº‹ä»¶å¤„ç† ====================

  /** æ•°å­—æŒ‰é’®ç‚¹å‡»ï¼šè¿½åŠ æ•°å­—åˆ°è¡¨è¾¾å¼ */
  onDigit(d: string): void { this.expression = this.expression + d; this.errorMsg = '' }

  /** è¿ç®—ç¬¦æŒ‰é’®ç‚¹å‡»ï¼šè¿½åŠ è¿ç®—ç¬¦åˆ°è¡¨è¾¾å¼ */
  onOp(op: string): void { this.expression = this.expression + op; this.errorMsg = '' }

  /** å‡½æ•°æŒ‰é’®ç‚¹å‡»ï¼šè¿½åŠ å‡½æ•°åå’Œå·¦æ‹¬å· */
  onFunc(f: string): void { this.expression = this.expression + f + '('; this.errorMsg = '' }

  /** å¸¸é‡æŒ‰é’®ç‚¹å‡»ï¼šè¿½åŠ å¸¸é‡åˆ°è¡¨è¾¾å¼ */
  onConst(c: string): void { this.expression = this.expression + c; this.errorMsg = '' }

  /** é€€æ ¼æŒ‰é’®ï¼šåˆ é™¤è¡¨è¾¾å¼æœ€åä¸€ä¸ªå­—ç¬¦ */
  onBS(): void { if (this.expression.length > 0) this.expression = this.expression.substring(0, this.expression.length - 1) }

  /** AC æŒ‰é’®ï¼šæ¸…ç©ºè¡¨è¾¾å¼ã€ç»“æœå’Œé”™è¯¯ä¿¡æ¯ */
  onAC(): void { this.expression = ''; this.result = ''; this.errorMsg = ''; ErrorFlags.reset() }

  /**
   * ç­‰å·æŒ‰é’®ï¼šæ‰§è¡Œè®¡ç®—
   * æµç¨‹ï¼šé¢„å¤„ç†è¡¨è¾¾å¼ â†’ é€’å½’ä¸‹é™è§£æ â†’ æ ¼å¼åŒ–ç»“æœ â†’ æ·»åŠ åˆ°å†å²
   */
  onEquals(): void {
    if (this.expression.length === 0) return
    ErrorFlags.reset()
    try {
      const clean: string = this.expr.getCleanExpression(this.expression, '.', ',')
      const raw: number = this.engine.evaluate(clean, !this.radianMode)

      // æŒ‰ä¼˜å…ˆçº§æ£€æŸ¥å„ç±»é”™è¯¯
      if (ErrorFlags.division_by_0) { this.errorMsg = 'é™¤æ•°ä¸èƒ½ä¸ºé›¶'; this.result = '' }
      else if (ErrorFlags.domain_error) { this.errorMsg = 'å®šä¹‰åŸŸé”™è¯¯'; this.result = '' }
      else if (ErrorFlags.syntax_error) { this.errorMsg = 'è¡¨è¾¾å¼é”™è¯¯'; this.result = '' }
      else if (ErrorFlags.is_infinity) { this.errorMsg = 'ç»“æœæ— ç©·å¤§'; this.result = '' }
      else if (ErrorFlags.require_real_number) { this.errorMsg = 'éœ€è¦å®æ•°'; this.result = '' }
      else {
        // æ ¼å¼åŒ–ç»“æœå¹¶æ·»åŠ åˆ°å†å²
        const fmt: string = NumberFormatter.format(raw.toString(), '.', ',', NumberingSystem.INTERNATIONAL)
        this.result = fmt; this.errorMsg = ''
        const item: HistoryItem = { id: this.nextId, expression: this.expression, result: fmt, timestamp: Date.now() }
        this.nextId = this.nextId + 1
        const nh: HistoryItem[] = [item]
        for (let i: number = 0; i < this.history.length; i++) nh.push(this.history[i])
        this.history = nh
        if (this.prefs) this.prefs.setHistory(this.history)
      }
    } catch (_e) { this.errorMsg = 'è®¡ç®—é”™è¯¯' }
  }

  /** é•¿æŒ‰ç»“æœåŒºï¼šå¤åˆ¶ç»“æœåˆ°å‰ªè´´æ¿ */
  onCopy(): void {
    if (this.result.length === 0) return
    pasteboard.getSystemPasteboard().setData(pasteboard.createData(pasteboard.MIMETYPE_TEXT_PLAIN, this.result))
    promptAction.showToast({ message: 'å·²å¤åˆ¶' })
  }

  /** ç‚¹å‡»å†å²æ¡ç›®ï¼šå›å¡«è¡¨è¾¾å¼åˆ°è¾“å…¥æ¡† */
  onHistoryTap(item: HistoryItem): void { this.expression = item.expression; this.showHistory = false }

  /** åˆ é™¤å†å²æ¡ç›® */
  onHistoryDelete(item: HistoryItem): void {
    const keep: HistoryItem[] = []
    for (let i: number = 0; i < this.history.length; i++) { if (this.history[i].id !== item.id) keep.push(this.history[i]) }
    this.history = keep
    if (this.prefs) this.prefs.setHistory(this.history)
  }

  // ==================== ä¸»é¢˜é¢œè‰² ====================

  /** è·å–å½“å‰ä¸»é¢˜çš„èƒŒæ™¯è‰² */
  getBg(): string {
    if (this.themeIdx === 1) return '#000000'  // AMOLED çº¯é»‘
    if (this.themeIdx === 2) return '#0d1117'  // Material You æš—è‰²
    return '#1a1a2e'                            // é»˜è®¤æ·±è“
  }

  /** è·å–æŒ‰é’®èƒŒæ™¯è‰² */
  getBtnBg(): string { return this.themeIdx === 1 ? '#1a1a1a' : '#2d2d44' }

  /** è·å–åŠŸèƒ½æŒ‰é’®èƒŒæ™¯è‰² */
  getFuncBg(): string { return this.themeIdx === 1 ? '#222' : '#3a3a5c' }

  /** è·å–é¢æ¿èƒŒæ™¯è‰² */
  getPanelBg(): string { return this.themeIdx === 1 ? '#111' : '#16213e' }

  // ==================== ä¸»å¸ƒå±€ï¼ˆæ”¯æŒæ¨ªç«–å±è‡ªé€‚åº”ï¼‰ ====================

  build() {
    Stack() {
      if (this.isLandscape) {
        // æ¨ªå±å¸ƒå±€ï¼šå·¦è¾¹æŒ‰é’®ç½‘æ ¼ + å³è¾¹å†å²é¢æ¿
        Row() {
          Column() {
            this.DisplayPanel()
            this.ToggleRow()
            this.ButtonGrid()
          }
          .layoutWeight(3).height('100%')
          this.HistoryPanel()
        }
        .width('100%').height('100%').backgroundColor(this.getBg())
      } else {
        // ç«–å±å¸ƒå±€ï¼šåŸæœ‰å¸ƒå±€
        Column() {
          this.DisplayPanel()
          this.ToggleRow()
          this.ButtonGrid()
          if (this.showHistory) this.HistoryPanel()
        }
        .width('100%').height('100%').backgroundColor(this.getBg())
      }
      if (this.showSettings) this.SettingsPanel()
      if (this.showAbout) this.AboutPanel()
    }
    .width('100%').height('100%')
    .onAreaChange((oldValue: Area, newValue: Area): void => {
      const w: number = newValue.width as number
      const h: number = newValue.height as number
      const wasLandscape: boolean = this.isLandscape
      this.isLandscape = w > h
      // åˆ‡æ¢åˆ°æ¨ªå±æ—¶è‡ªåŠ¨å¼€å¯ç§‘å­¦æ¨¡å¼+å†å²é¢æ¿
      if (!wasLandscape && this.isLandscape) {
        this.scientific = true
        this.showHistory = true
      }
    })
  }

  // ==================== æ˜¾ç¤ºå±é¢æ¿ ====================

  @Builder DisplayPanel() {
    Column() {
      // è¡¨è¾¾å¼æ˜¾ç¤ºè¡Œï¼ˆå°å­—ï¼Œç°è‰²ï¼‰
      Text(this.expression.length > 0 ? this.expression : ' ')
        .fontSize(18).fontColor('#888').width('100%').textAlign(TextAlign.End)
        .padding({ right: 16, left: 16 }).maxLines(3)

      // ç»“æœæˆ–é”™è¯¯æ˜¾ç¤ºè¡Œ
      if (this.errorMsg.length > 0) {
        // é”™è¯¯ä¿¡æ¯ï¼ˆçº¢è‰²å¤§å­—ï¼‰
        Text(this.errorMsg).fontSize(28).fontColor('#FF6B6B')
          .width('100%').textAlign(TextAlign.End).padding({ right: 16, left: 16 })
      } else {
        // è®¡ç®—ç»“æœï¼ˆç™½è‰²å¤§å­—ï¼‰
        Text(this.result.length > 0 ? this.result : '0')
          .fontSize(36).fontWeight(FontWeight.Bold).fontColor('#FFFFFF')
          .width('100%').textAlign(TextAlign.End).padding({ right: 16, left: 16 })
      }
    }
    .width('100%').padding({ top: 24, bottom: 8 })
    .gesture(LongPressGesture().onAction((): void => { this.onCopy() }))  // é•¿æŒ‰å¤åˆ¶ç»“æœ
  }

  // ==================== æ¨¡å¼åˆ‡æ¢æ  ====================

  @Builder ToggleRow() {
    Row() {
      // ç§‘å­¦/åŸºç¡€æ¨¡å¼åˆ‡æ¢
      Text(this.scientific ? 'ç§‘å­¦' : 'åŸºç¡€')
        .fontSize(12).fontColor('#26b89c')
        .padding({ left: 12, right: 12, top: 4, bottom: 4 })
        .border({ width: 1, color: '#26b89c', radius: 8 })
        .onClick((): void => { this.scientific = !this.scientific })
      Blank()
      // å†å²é¢æ¿å¼€å…³
      Text(this.showHistory ? 'â–² å†å²' : 'â–¼ å†å²')
        .fontSize(12).fontColor('#888').padding(8)
        .onClick((): void => { this.showHistory = !this.showHistory })
      // è®¾ç½®æŒ‰é’®
      Text('âš™').fontSize(16).fontColor('#888').padding(8)
        .onClick((): void => { this.showSettings = true })
    }
    .width('100%').padding({ left: 16, right: 16, bottom: 4 })
  }

  // ==================== æŒ‰é’®ç½‘æ ¼ ====================

  @Builder ButtonGrid() {
    Column() {
      // ç§‘å­¦æ¨¡å¼é¢å¤–æŒ‰é’®è¡Œ
      if (this.scientific) {
        Row() { this.BtnFunc('sin'); this.BtnFunc('cos'); this.BtnFunc('tan'); this.BtnFunc('ln'); this.BtnFunc('log') }
        Row() { this.BtnFunc('arcsi'); this.BtnFunc('arcco'); this.BtnFunc('arcta'); this.BtnConst('Ï€'); this.BtnConst('e') }
      }
      // æ ‡å‡†æŒ‰é’®è¡Œ
      Row() { this.BtnAct('AC'); this.BtnOp('('); this.BtnOp(')'); this.BtnOp('Ã·') }
      Row() { this.BtnDig('7'); this.BtnDig('8'); this.BtnDig('9'); this.BtnOp('Ã—') }
      Row() { this.BtnDig('4'); this.BtnDig('5'); this.BtnDig('6'); this.BtnOp('-') }
      Row() { this.BtnDig('1'); this.BtnDig('2'); this.BtnDig('3'); this.BtnOp('+') }
      Row() { this.BtnDig('0'); this.BtnOp('.'); this.BtnAct('âŒ«'); this.BtnEq() }
    }
    .width('100%').padding({ left: 8, right: 8 }).layoutWeight(1)  // å¡«å……å‰©ä½™ç©ºé—´
  }

  // ==================== æŒ‰é’®æ„å»ºå™¨ ====================

  /** æ•°å­—æŒ‰é’®ï¼ˆç™½è‰²æ–‡å­—ï¼Œæ·±è‰²èƒŒæ™¯ï¼‰ */
  @Builder BtnDig(l: string) { Text(l).fontSize(this.isLandscape ? 18 : 22).fontColor('#FFFFFF').width('22%').height(this.isLandscape ? 40 : 56).textAlign(TextAlign.Center).backgroundColor(this.getBtnBg()).borderRadius(12).margin(this.isLandscape ? 2 : 4).onClick((): void => { this.onDigit(l) }) }

  /** è¿ç®—ç¬¦æŒ‰é’®ï¼ˆç™½è‰²æ–‡å­—ï¼Œé’ç»¿è‰²èƒŒæ™¯ï¼‰ */
  @Builder BtnOp(l: string) { Text(l).fontSize(this.isLandscape ? 16 : 20).fontColor('#FFFFFF').width('22%').height(this.isLandscape ? 40 : 56).textAlign(TextAlign.Center).backgroundColor('#26b89c').borderRadius(12).margin(this.isLandscape ? 2 : 4).onClick((): void => { this.onOp(l) }) }

  /** ç§‘å­¦å‡½æ•°æŒ‰é’®ï¼ˆå°å­—ï¼Œç´«è‰²èƒŒæ™¯ï¼‰ */
  @Builder BtnFunc(l: string) { Text(l).fontSize(this.isLandscape ? 12 : 14).fontColor('#FFFFFF').width('18%').height(this.isLandscape ? 34 : 46).textAlign(TextAlign.Center).backgroundColor(this.getFuncBg()).borderRadius(10).margin(this.isLandscape ? 2 : 3).onClick((): void => { this.onFunc(l) }) }

  /** å¸¸é‡æŒ‰é’®ï¼ˆé’ç»¿è‰²æ–‡å­—ï¼Œæ·±è‰²èƒŒæ™¯ï¼‰ */
  @Builder BtnConst(l: string) { Text(l).fontSize(this.isLandscape ? 14 : 18).fontColor('#26b89c').width('18%').height(this.isLandscape ? 34 : 46).textAlign(TextAlign.Center).backgroundColor(this.getBtnBg()).borderRadius(10).margin(this.isLandscape ? 2 : 3).onClick((): void => { this.onConst(l) }) }

  /** åŠ¨ä½œæŒ‰é’®ï¼ˆAC çº¢è‰²ï¼Œé€€æ ¼ç°è‰²ï¼‰ */
  @Builder BtnAct(l: string) { Text(l).fontSize(this.isLandscape ? 16 : 20).fontColor(l === 'AC' ? '#FF6B6B' : '#888').width('22%').height(this.isLandscape ? 40 : 56).textAlign(TextAlign.Center).backgroundColor(this.getBtnBg()).borderRadius(12).margin(this.isLandscape ? 2 : 4).onClick((): void => { if (l === 'AC') this.onAC(); else this.onBS() }) }

  /** ç­‰å·æŒ‰é’®ï¼ˆæ·±è‰²æ–‡å­—ï¼Œé’ç»¿è‰²èƒŒæ™¯ï¼ŒåŠ ç²—ï¼‰ */
  @Builder BtnEq() { Text('=').fontSize(this.isLandscape ? 20 : 24).fontWeight(FontWeight.Bold).fontColor('#1a1a2e').width('22%').height(this.isLandscape ? 40 : 56).textAlign(TextAlign.Center).backgroundColor('#26b89c').borderRadius(12).margin(this.isLandscape ? 2 : 4).onClick((): void => { this.onEquals() }) }

  // ==================== å†å²è®°å½•é¢æ¿ ====================
  // ç«–å±ï¼šåº•éƒ¨å¼¹å‡ºé¢æ¿ï¼›æ¨ªå±ï¼šå³ä¾§å›ºå®šé¢æ¿

  @Builder HistoryPanel() {
    Column() {
      Text('å†å²è®°å½•')
        .fontSize(this.isLandscape ? 14 : 16)
        .fontWeight(FontWeight.Bold)
        .fontColor('#FFFFFF')
        .width('100%')
        .padding(this.isLandscape ? 8 : 16)

      if (this.history.length === 0) {
        // ç©ºçŠ¶æ€å¼•å¯¼
        Text('æš‚æ— è®¡ç®—è®°å½•').fontSize(13).fontColor('#666').width('100%').textAlign(TextAlign.Center).padding(20)
      } else {
        List() {
          ForEach(this.history, (item: HistoryItem) => {
            ListItem() {
              Column() {
                Text(item.expression).fontSize(12).fontColor('#ccc').maxLines(1)
                Text(item.result).fontSize(this.isLandscape ? 14 : 16).fontWeight(FontWeight.Bold).fontColor('#26b89c')
              }
              .alignItems(HorizontalAlign.Start)
              .width('100%')
              .padding(this.isLandscape ? 8 : 12)
              .onClick((): void => { this.onHistoryTap(item) })  // ç‚¹å‡»å›å¡«
            }
            .swipeAction({ end: { builder: (): void => { this.DelBtn(item) } } })  // å·¦æ»‘å‡ºç°åˆ é™¤æŒ‰é’®
          })
        }
        .height(this.isLandscape ? '100%' : 200)
      }
    }
    .layoutWeight(this.isLandscape ? 1 : 0)
    .width(this.isLandscape ? '100%' : '100%')
    .height(this.isLandscape ? '100%' : 'auto')
    .backgroundColor(this.getPanelBg())
    .borderRadius(this.isLandscape ? 0 : { topLeft: 16, topRight: 16 })
    .padding({ top: this.isLandscape ? 8 : 12 })
  }

  /** å†å²æ¡ç›®åˆ é™¤æŒ‰é’®ï¼ˆçº¢è‰²ï¼‰ */
  @Builder DelBtn(item: HistoryItem) {
    Text('åˆ é™¤').fontSize(14).fontColor('#FFFFFF').padding(16).backgroundColor('#FF6B6B').height('100%')
      .onClick((): void => { this.onHistoryDelete(item) })
  }

  // ==================== è®¾ç½®é¢æ¿ ====================
  // å±…ä¸­è¦†ç›–å±‚ï¼ŒåŒ…å«æŒ¯åŠ¨ã€é˜²ä¼‘çœ ã€å¼§åº¦æ¨¡å¼ã€ä¸»é¢˜åˆ‡æ¢å’Œå…³äºå…¥å£

  @Builder SettingsPanel() {
    Column() {
      // æ ‡é¢˜æ 
      Row() {
        Text('è®¾ç½®').fontSize(18).fontWeight(FontWeight.Bold).fontColor('#FFFFFF')
        Blank()
        Text('âœ•').fontSize(20).fontColor('#888').onClick((): void => { this.showSettings = false })
      }
      .width('100%').padding(16)

      List() {
        // æŒ¯åŠ¨åé¦ˆå¼€å…³
        ListItem() { this.ToggleItem('æŒ¯åŠ¨åé¦ˆ', this.vibrateOn, (v: boolean): void => { this.vibrateOn = v; this.savePref('vibrateOn', v) }) }
        // é˜²ä¼‘çœ å¼€å…³
        ListItem() { this.ToggleItem('é˜²ä¼‘çœ ', this.preventSleep, (v: boolean): void => { this.preventSleep = v; this.savePref('preventSleep', v) }) }
        // å¼§åº¦æ¨¡å¼å¼€å…³
        ListItem() { this.ToggleItem('å¼§åº¦æ¨¡å¼', this.radianMode, (v: boolean): void => { this.radianMode = v; this.savePref('radianMode', v) }) }
        // ä¸»é¢˜é€‰æ‹©
        ListItem() { this.ThemeItem() }
        // å…³äºå…¥å£
        ListItem() {
          Row() { Text('å…³äº OpenCalc').fontSize(15).fontColor('#ccc'); Blank(); Text('>').fontColor('#888') }
          .width('100%').padding(12)
          .onClick((): void => { this.showSettings = false; this.showAbout = true })
        }
      }
    }
    .width('85%').backgroundColor(this.getPanelBg()).borderRadius(16)
  }

  /** å¼€å…³è®¾ç½®é¡¹ï¼ˆæ ‡é¢˜ + Toggle å¼€å…³ï¼‰ */
  @Builder ToggleItem(title: string, val: boolean, cb: (v: boolean) => void) {
    Row() {
      Text(title).fontSize(15).fontColor('#FFFFFF').layoutWeight(1)
      Toggle({ type: ToggleType.Switch, isOn: val }).onChange((on: boolean): void => { cb(on) })
    }
    .width('100%').padding(12)
  }

  /** ä¸»é¢˜é€‰æ‹©é¡¹ï¼ˆä¸‰ä¸ªæŒ‰é’®ï¼šé»˜è®¤ / AMOLED / Materialï¼‰ */
  @Builder ThemeItem() {
    Row() {
      Text('ä¸»é¢˜').fontSize(15).fontColor('#FFFFFF').layoutWeight(1)
      Row() {
        Text('é»˜è®¤')
          .fontSize(11).fontColor(this.themeIdx === 0 ? '#1a1a2e' : '#888')
          .backgroundColor(this.themeIdx === 0 ? '#26b89c' : '#333')
          .padding({ left: 8, right: 8, top: 4, bottom: 4 }).borderRadius(8).margin({ left: 2 })
          .onClick((): void => { this.themeIdx = 0; this.savePref('themeIdx', 0) })
        Text('AMOLED')
          .fontSize(11).fontColor(this.themeIdx === 1 ? '#1a1a2e' : '#888')
          .backgroundColor(this.themeIdx === 1 ? '#26b89c' : '#333')
          .padding({ left: 8, right: 8, top: 4, bottom: 4 }).borderRadius(8).margin({ left: 2 })
          .onClick((): void => { this.themeIdx = 1; this.savePref('themeIdx', 1) })
        Text('Material')
          .fontSize(11).fontColor(this.themeIdx === 2 ? '#1a1a2e' : '#888')
          .backgroundColor(this.themeIdx === 2 ? '#26b89c' : '#333')
          .padding({ left: 8, right: 8, top: 4, bottom: 4 }).borderRadius(8).margin({ left: 2 })
          .onClick((): void => { this.themeIdx = 2; this.savePref('themeIdx', 2) })
      }
    }
    .width('100%').padding(12)
  }

  // ==================== å…³äºé¢æ¿ ====================
  // å±…ä¸­è¦†ç›–å±‚ï¼Œæ˜¾ç¤ºç‰ˆæœ¬ä¿¡æ¯å’Œé¡¹ç›®é“¾æ¥

  @Builder AboutPanel() {
    Column() {
      Text('å…³äº OpenCalc').fontSize(18).fontWeight(FontWeight.Bold).fontColor('#FFFFFF').padding({ bottom: 12 })
      Text('OpenCalc HarmonyOS').fontSize(14).fontColor('#ccc')
      Text('ç‰ˆæœ¬ 1.0.0').fontSize(14).fontColor('#ccc').padding({ top: 4 })
      Text('åŸé¡¹ç›®: github.com/clementwzk/OpenCalc').fontSize(11).fontColor('#888').padding({ top: 8 })
      Text('Android 3.2.1 â†’ HarmonyOS').fontSize(11).fontColor('#888').padding({ top: 2 })
      Text('è¿ç§»: github.com/JungleTestLabs/opencalc-harmonyos').fontSize(11).fontColor('#26b89c').padding({ top: 4 })
      Button('å…³é—­').margin({ top: 16 }).onClick((): void => { this.showAbout = false })
    }
    .width('80%').padding(24).backgroundColor(this.getPanelBg()).borderRadius(16)
  }
}
